HOST=0.0.0.0
PORT={{ service_port }}
MANAGEMENT_PORT={{ management_port }}
LOG_LEVEL=INFO
LOGGING_STRUCTURED=false

# OpenTelemetry — set by platform at deploy time
# OTEL_SERVICE_NAME={{ project-name }}
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
{% if persistence == 'PostgreSQL' %}
# PostgreSQL — injected by PAO from connection secret
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=user
# DB_PASSWORD=pass
# DB_DBNAME={{ project-name }}
{% endif %}
{% if persistence == 'MySQL' %}
# MySQL — injected by PAO from connection secret
# DB_HOST=localhost
# DB_PORT=3306
# DB_USERNAME=user
# DB_PASSWORD=pass
# DB_DBNAME={{ project-name }}
{% endif %}
{% if cache ~= 'None' %}
# Redis — injected by PAO from connection secret
# CACHE_HOST=localhost
# CACHE_PORT=6379
# CACHE_USERNAME=
# CACHE_PASSWORD=
{% endif %}
{% if messaging == 'Kafka' %}
# Kafka — injected by PAO from connection secret (camelCase -> UPPER_SNAKE)
# MESSAGING_BROKERS=localhost:9092
# MESSAGING_TOPIC={{ project-name }}
# MESSAGING_USERNAME=
# MESSAGING_PASSWORD=
# MESSAGING_SASL_MECHANISM=PLAIN
{% endif %}
{% if messaging == 'Pulsar' %}
# Pulsar — injected by PAO from connection secret (camelCase -> UPPER_SNAKE)
# MESSAGING_BROKER_URL=pulsar://localhost:6650
# MESSAGING_TOPIC=persistent://public/default/{{ project-name }}
# MESSAGING_JWT_TOKEN=
# MESSAGING_SUBSCRIPTION_NAME={{ project-name }}-sub
{% endif %}
